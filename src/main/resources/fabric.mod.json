			"me.anedhel.LotRMEMod"
		],
		"fabric-datagen": [
			"me.anedhel.LotRMEModDataGenerator"
		]
	},
	"mixins": [
		"lotr.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
