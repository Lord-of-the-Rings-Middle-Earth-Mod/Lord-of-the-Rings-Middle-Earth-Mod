{
	"schemaVersion": 1,
	"id": "lotr",
	"version": "${version}",
	"name": "Lord of the Rings Middle Earth",
	"description": "The *Lord of the Rings Middle Earth Mod* (*LotR ME Mod* in short) is a mod that aims to bring the world of J.R.R. Tolkiens Books into Minecraft.",
	"authors": [
		"Anedhel"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/Lord-of-the-Rings-Middle-Earth-Mod/Lord-of-the-Rings-Middle-Earth-Mod"
	},
	"license": "GPL-3.0",
	"icon": "assets/lotr/lotr_middle_earth_mod_logo.png",
