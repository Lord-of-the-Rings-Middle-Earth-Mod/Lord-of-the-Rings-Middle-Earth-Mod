	"entrypoints": {
		"main": [
          "me.anedhel.lotr.LordOfTheRingsMiddleEarthMod"
		],
		"client": [
			"me.anedhel.lotr.LordOfTheRingsMiddleEarthModClient"
		],
		"fabric-datagen": [
			"me.anedhel.lotr.LordOfTheRingsMiddleEarthModDataGenerator"
		]
	},
	"mixins": [
		"lotr-middle-earth.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.20.6",
