	"description": "This mod is meant to implement content from the Lord of the Rings Middle-Earth universe into Minecraft.",
	"authors": [
		"Anedhel"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/Lord-of-the-Rings-Middle-Earth-Mod/LotR-ME-Mod"
	},
	"license": "GPL-3.0",
	"icon": "assets/lotr/mod_logo.png",
	"environment": "*",
	"entrypoints": {
