{
	"schemaVersion": 1,
	"id": "vext",
	"version": "${version}",
	"name": "Vanilla Extensions Mod",
	"description": "This Mod extends Vanilla Minecraft with generic content",
	"authors": [
		"Moritz Rohleder"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/Lord-of-the-Rings-Middle-Earth-Mod/VExt-Mod"
	},
	"license": "GPL-3.0",
	"icon": "assets/vext/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.anedhel.vext.VExtMod"
		],
		"fabric-datagen": [
			"com.anedhel.vext.VExtModDataGenerator"
		],
		"client": [
			"com.anedhel.vext.VExtModClient"
		]
	},
	"mixins": [
		"vext.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}